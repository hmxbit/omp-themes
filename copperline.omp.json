{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    { "type": "prompt", "alignment": "left", "newline": true, "segments": [
      { "type": "path", "style": "powerline", "powerline_symbol": "", "foreground": "#1b1510", "background": "#c78c55", "template": " {{ .Path }} ", "options": { "style": "full" } },
      { "type": "git", "style": "powerline", "powerline_symbol": "", "foreground": "#f5ddbd", "background": "#584331", "template": " {{ .HEAD }} ", "options": { "branch_icon": " " } }
    ] },
    { "type": "prompt", "alignment": "left", "newline": true, "segments": [
      { "type": "git", "style": "plain", "foreground": "#b7c98d", "template": "{{ if .Working.Changed }}{{ .Working.String }}{{ end }}{{ if .Staging.Changed }}{{ if .Working.Changed }}  {{ end }}+{{ add .Staging.Added .Staging.Modified .Staging.Deleted .Staging.Unmerged }} staged{{ end }}{{ if not (or .Working.Changed .Staging.Changed) }}✓ clean{{ end }}{{ if gt .Ahead 0 }}  ↑{{ .Ahead }} ahead{{ end }}{{ if gt .Behind 0 }}  ↓{{ .Behind }} behind{{ end }}", "options": { "fetch_status": true } },
      { "type": "go", "style": "plain", "foreground": "#958979", "template": "{{ if .Segments.Contains \"Git\" }} · {{ end }}go {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}" }
    ] },
    { "type": "prompt", "alignment": "left", "newline": true, "segments": [
      { "type": "text", "style": "plain", "foreground": "#e8a96b", "template": "❯" }
    ] }
  ]
}
