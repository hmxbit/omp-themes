{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:pink",
          "template": "{{ .Path }} ",
          "options": {
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "agnoster_short"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:lavender",
          "template": "{{ .HEAD }} ",
          "options": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          }
        },
        {
          "type": "claude",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \uf0bc9 {{ .Model.DisplayName }} \uf2d0 {{ .TokenUsagePercent.Gauge }}",
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "p:pink"
        },
        {
          "type": "copilot",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \uec1e {{ .Premium.Percent.Gauge }} ",
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "p:pink"
        },
        {
          "type": "copilot_cli",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \uec1e {{ .Model.DisplayName }} \uf2d0 {{ .TokenGauge }}",
          "foreground": "p:pink"
        },
        {
          "type": "aws",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "cache": {
            "duration": "1h",
            "strategy": "session"
          },
          "foreground": "p:pink"
        },
        {
          "type": "terraform",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \ue8bd {{ .WorkspaceName }} ",
          "cache": {
            "duration": "5m",
            "strategy": "folder"
          },
          "foreground": "p:pink"
        },
        {
          "type": "go",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": "\ue724 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "p:pink"
        },
        {
          "type": "python",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "p:pink"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:lavender",
          "template": "\u276f"
        },
        {
          "type": "root",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \uf0e7 ",
          "foreground": "#e84545"
        }
      ],
      "newline": true
    }
  ],
  "palette": {
    "os": "#ACB0BE",
    "closer": "p:os",
    "pink": "#ea76cb",
    "lavender": "#7287FD",
    "blue": "#1e66f5"
  }
}
