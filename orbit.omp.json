{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#d4d0ff",
          "background": "#29254d",
          "template": " {{ .Path }} ",
          "options": { "style": "full" }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#8ce4f2",
          "background": "#153740",
          "template": " {{ .HEAD }} ",
          "options": { "branch_icon": " " }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#ffc4dc",
          "background": "#492b41",
          "template": " {{ if .Working.Changed }}{{ .Working.String }}{{ end }}{{ if .Staging.Changed }}{{ if .Working.Changed }} {{ end }}+{{ add .Staging.Added .Staging.Modified .Staging.Deleted .Staging.Unmerged }}{{ end }}{{ if gt .Ahead 0 }}{{ if or .Working.Changed .Staging.Changed }} {{ end }}↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }}{{ if or .Working.Changed .Staging.Changed (gt .Ahead 0) }} {{ end }}↓{{ .Behind }}{{ end }}{{ if not (or .Working.Changed .Staging.Changed) }}{{ if or (gt .Ahead 0) (gt .Behind 0) }} {{ end }}✓{{ end }} ",
          "options": { "fetch_status": true }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#777b9a",
          "template": "{{ if .Segments.Contains \"Git\" }} {{ end }}node {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#777b9a",
          "template": "{{ .FormattedMs }}",
          "options": { "threshold": 500, "style": "austin" }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        { "type": "text", "style": "plain", "foreground": "#9f9bff", "template": "✦ ❯" }
      ]
    }
  ]
}
